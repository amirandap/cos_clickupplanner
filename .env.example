# --- Required ---------------------------------------------------------------
# Public origin of the app. Used for OAuth redirect URIs, cookie flags (Secure
# when https) and the CSRF Origin check.
APP_URL="http://127.0.0.1:3000"
DATABASE_URL="file:./dev.db"
# One Google OAuth client for the whole app (type Internal in Google Cloud).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 32 random bytes in base64 (openssl rand -base64 32). Encrypts every stored token.
TOKEN_ENCRYPTION_KEY=""

# --- Optional ---------------------------------------------------------------
# Key rotation. Bump the version when you replace TOKEN_ENCRYPTION_KEY and list
# the previous keys as "version:base64" pairs so they can still decrypt.
TOKEN_ENCRYPTION_KEY_VERSION="1"
TOKEN_ENCRYPTION_KEYS_OLD=""
# Empty = any verified Google account may sign in (Google's Internal client
# type already limits who can). Set e.g. "example.com" to also enforce it here.
AUTH_ALLOWED_DOMAIN=""
# Who claims the data of the former single user. Empty = the first login.
BOOTSTRAP_ADMIN_EMAIL=""
# Default timezone for new users (each user can change theirs in Settings).
APP_TIMEZONE="UTC"
# Demo mode with synthetic data and no login. Ignored when NODE_ENV=production.
USE_MOCK_DATA=true
